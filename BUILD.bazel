load("@rules_python//python:pip.bzl", "compile_pip_requirements")

compile_pip_requirements(
    name = "python_requirements",
    extra_args = ["--allow-unsafe"],
    requirements_in = ":requirements.txt",
    requirements_txt = ":requirements_lock.txt",
    tags = ["manual"],
)

exports_files([
    "requirements.txt",
    "requirements_lock.txt",
])

platform(
    name = "aarch64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "x86_64_build",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "aarch64_build",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

py_library(
    name = "numpy",
    visibility = ["//visibility:public"],
    deps = select({
        "//:aarch64_build": ["@rules_ros2_pip_deps_aarch64//numpy"],
        "//:x86_64_build": ["@rules_ros2_pip_deps_x86_64//numpy"],
    }),
)

cc_library(
    name = "numpy_lib",
    visibility = ["//visibility:public"],
    deps = select({
        "//:aarch64_build": ["@rules_ros2_pip_deps_aarch64//numpy:numpy_lib"],
        "//:x86_64_build": ["@rules_ros2_pip_deps_x86_64//numpy:numpy_lib"],
    }),
)
