load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# Selects the rmw (DDS) implementation at build time. Read by the interface
# generators (fastrtps typesupport for zenoh) and by ros2_rmw_implementation.
string_flag(
    name = "rmw",
    build_setting_default = "cyclonedds",
    values = [
        "cyclonedds",
        "zenoh",
    ],
    visibility = ["//visibility:public"],
)

compile_pip_requirements(
    name = "python_requirements",
    extra_args = ["--allow-unsafe"],
    requirements_in = ":requirements.txt",
    requirements_txt = ":requirements_lock.txt",
    tags = ["manual"],
)

exports_files([
    "requirements.txt",
    "requirements_lock.txt",
])

py_library(
    name = "numpy",
    visibility = ["//visibility:public"],
    deps = ["@rules_ros2_pip_deps//numpy"],
)

cc_library(
    name = "numpy_lib",
    visibility = ["//visibility:public"],
    deps = ["@rules_ros2_pip_deps//numpy:numpy_lib"],
)
