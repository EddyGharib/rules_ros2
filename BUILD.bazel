load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# The rmw flag lives in rules_ros2_interfaces; kept here so existing
# --@com_github_mvukov_rules_ros2//:rmw=... settings keep working.
alias(
    name = "rmw",
    actual = "@rules_ros2_interfaces//:rmw",
    visibility = ["//visibility:public"],
)

compile_pip_requirements(
    name = "python_requirements",
    extra_args = ["--allow-unsafe"],
    requirements_in = ":requirements.txt",
    requirements_txt = ":requirements_lock.txt",
    tags = ["manual"],
)

exports_files([
    "requirements.txt",
    "requirements_lock.txt",
])

alias(
    name = "numpy",
    actual = "@rules_ros2_interfaces//:numpy",
    visibility = ["//visibility:public"],
)

alias(
    name = "numpy_lib",
    actual = "@rules_ros2_interfaces//:numpy_lib",
    visibility = ["//visibility:public"],
)
